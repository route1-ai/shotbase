# ──────────────────────────────────────────────────────────────
# SELF-HOSTING (required)
# Copy this file to .env, fill in API_KEYS, then: docker compose up
# ──────────────────────────────────────────────────────────────

# Comma-separated list of API keys that are allowed to call the API.
# Generate any string you like, e.g.: openssl rand -hex 32
API_KEYS=YOUR_KEY

# Port the server listens on inside the container (8080 is the default).
PORT=8080

# Redis connection URL — set automatically by docker-compose.yml.
# Override only if you are bringing your own Redis instance.
REDIS_URL=redis://redis:6379

# Browser concurrency gate (all optional — safe defaults shown)
MAX_BROWSER_CONCURRENCY=4
MAX_BROWSER_QUEUE=20
BROWSER_QUEUE_TIMEOUT_MS=10000

# Max request body size in bytes (optional; default 1 MiB)
MAX_BODY_BYTES=1048576

# ── AI extraction (optional) ──────────────────────────────────
# Powers the `ai_extract` field. Leave blank and screenshots still work —
# ai_extract requests then return 400 with an explanation.
#
# Any OpenAI-compatible /chat/completions endpoint works. Pick one:
#
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1
#               AI_MODEL=gpt-4o-mini
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1
#               AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1
#               AI_MODEL=anthropic/claude-haiku-4.5
#   DeepSeek    AI_BASE_URL=https://api.deepseek.com/v1
#               AI_MODEL=deepseek-chat
#   Ollama      AI_BASE_URL=http://host.docker.internal:11434/v1
#               AI_MODEL=llama3.2        (no AI_API_KEY needed — fully local,
#                                         page text never leaves your machine)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Token budget for the extraction reply. Reasoning models (gpt-oss, qwen3) bill
# their thinking against this, so a low value can leave no room for the answer.
AI_MAX_TOKENS=4096

# ──────────────────────────────────────────────────────────────
# HOSTED MODE ONLY (leave blank when self-hosting)
#
# Leaving these unset disables accounts, billing, and quota
# metering. Static API_KEYS auth is used instead.
# ──────────────────────────────────────────────────────────────

# Unkey — per-plan rate limiting and key management (shotbase.dev)
UNKEY_ROOT_KEY=

# Supabase — usage logging and quota enforcement (shotbase.dev)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Playground bypass key — lets the hosted playground skip key auth
PLAYGROUND_BYPASS_KEY=

# AWS Bedrock — what the hosted service uses for ai_extract.
# Self-hosting? Use the AI_* block above instead; it is far easier to get.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
